---
title: Tags
---

<h1>Tags</h1>

<ul class="tags-index">
  {% for tagSet in collections.all | getAllTags | filterTagList | groupedByLetter %}
    <li>
      {{ tagSet.letter }}
      <ul>
        {% for tag in tagSet.tags %}
          {% set tagUrl %}/{{ tag | slugify }}/{% endset %}
          <li><a href="{{ tagUrl }}">{{ tag }}</a> ({{ collections[tag].length }})</li>
        {% endfor %}
      </ul>
    </li>
  {% endfor %}
</ul>