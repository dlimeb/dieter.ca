<ol reversed class="post-list {% if showFullPosts %}post-list-full{% else %}post-list-titles{% endif %}">

{% for post in postslist | reverse %}

  {% set title = post.data.title %}
  {% set url = post.url %}
  {% set date = post.data.date %}
  {% set tags = post.data.tags %}

  <li class="post-list-item">

    {% if showFullPosts %}
      <article class="post u-grid">
        <header class="page-title">
          {% include "components/post-title.njk" %}
          {% include "components/post-metadata.njk" %}
        </header>

        <div class="main-content">
          {{ post.content | safe }}
        </div>
      </article>

    {% else %}
      <article>
        <header>
          {% include "components/post-title.njk" %}
          {% include "components/post-metadata.njk" %}
        </header>

        {% if showSummary %}
          <p class="post-excerpt">
            {% if post.data.summary %}
              {{ post.data.summary }}
            {% else %}
              {{ post.content | safe | striptags | truncate }}
            {% endif %}
            <a href="{{ post.url }}" class="read-more">Continue</a>
          </p>
        {% endif %}
      </article>
    {% endif %}
  </li>

{% endfor %}

</ol>
