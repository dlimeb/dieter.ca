{%- css %}.postlist { counter-reset: start-from {{ (postslistCounter or postslist.length) + 1 }} }{% endcss %}

<ol reversed class="post-list">
{%- for post in postslist | reverse %}
	<li class="post-list-item{% if post.url == url %} active{% endif %}">
		<a href="{{ post.url }}">{% if post.data.title %}{{ post.data.title }}{% else %}<code>{{ post.url }}</code>{% endif %}</a>
		<time class="post-list-date" datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate("DDD") }}</time>
	</li>
{%- endfor %}
</ol>