<header>
  <a href="/">{{ metadata.title }}</a>
  <nav>
    <h2 class="u-sr-only">Main navigation menu</h2>
    <ul>
      {%- for entry in collections.all | eleventyNavigation %}
        <li>
          <a href="{{ entry.url }}"{% if entry.url == page.url %} class="active" aria-current="page"{% endif %}>{{ entry.title }}</a>
        </li>
      {%- endfor %}
    </ul>
  </nav>
</header>
