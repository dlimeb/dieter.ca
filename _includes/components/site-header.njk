<header class="site-header u-container">
  <nav>
    <h2 class="u-visually-hidden">Main navigation menu</h2>
    <ul>
      <li><a href="/">{{ metadata.title }}</a></li>
      {%- for entry in collections.all | eleventyNavigation %}
        <li>
          <a href="{{ entry.url }}"{% if entry.url == page.url %} class="active" aria-current="page"{% endif %}>{{ entry.title }}</a>
        </li>
      {%- endfor %}
    </ul>
  </nav>
</header>
