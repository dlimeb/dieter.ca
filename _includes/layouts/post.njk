---
layout: layouts/base
---
<heading-anchors>
<article class="post u-grid">
  <header class="page-title">
		{%- if title %}
			<h1 class="post-title">{{ title | safe }}</h1>
		{% endif %}
		<div class="post-metadata">
			<time class="post-timestamp" datetime="{{ page.date | htmlDateString }}">{{ page.date | readableDate }}</time>
			<ul class="post-tags">
				{%- for tag in tags | filterTagList %}
				{%- set tagUrl %}/{{ tag | slugify }}/{% endset %}
				<li><a href="{{ tagUrl }}" class="post-tag">{{ tag }}</a>{%- if not loop.last %}, {% endif %}</li>
				{%- endfor %}
			</ul>
		</div>
	</header>

  <div class="main-content">
		{{ content | safe }}
  </div>

	<footer>
		{%- if collections.posts %}
			{%- set previousPost = collections.posts | getPreviousCollectionItem %}
			{%- set nextPost = collections.posts | getNextCollectionItem %}
			{%- if nextPost or previousPost %}
				<ul class="links-nextprev">
					<li class="links-nextprev-prev">
						{%- if previousPost %}<span class="nextprev-arrow">← </span>Previous<br> <a href="{{ previousPost.url }}">{{ previousPost.data.title }}</a>{% endif %}
					</li>
					<li class="links-nextprev-next">
						{%- if nextPost %}Next<span class="nextprev-arrow"> →</span><br><a href="{{ nextPost.url }}">{{ nextPost.data.title }}</a>{% endif %}
					</li>
				</ul>
			{%- endif %}
		{%- endif %}
	</footer>
</article>
</heading-anchors>