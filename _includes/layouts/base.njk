<!doctype html>
<html lang="{{ metadata.language }}">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>{% if title and title != metadata.title %}{{title}} • {%endif %} {{ metadata.title }}</title>
		<meta name="description" content="{{ description or metadata.description }}">
		<link rel="alternate" href="/feed/feed.xml" type="application/atom+xml" title="{{ metadata.title }}">
		<meta name="generator" content="{{ eleventy.generator }}">
		<link rel="icon" type="image/svg+xml" href="/assets/favicon/favicon.svg" />
		<link rel="icon" type="image/png" href="/assets/favicon/favicon-96x96.png" sizes="96x96" />
		<link rel="apple-touch-icon" sizes="180x180" href="/assets/favicon/apple-touch-icon.png" />

		{% set css %}
			{% include "node_modules/@dlimeb/cssium/css/color.css" %}
			{% include "node_modules/@dlimeb/cssium/css/layout.css" %}
			{% include "node_modules/@dlimeb/cssium/css/typography.css" %}
			{% include "node_modules/@dlimeb/cssium/css/utilities.css" %}
			{% include "node_modules/@dlimeb/cssium/css/content.css" %}
			{% include "node_modules/@dlimeb/cssium/extras/tooltips.css" %}

			{% include "components/page.css" %}
			{% include "components/site-headerfooter.css" %}
			{% include "components/home.css" %}
			{% include "components/posts.css" %}
			{% include "components/tags-list.css" %}
		{% endset %}
		<style>{{ css | cssmin | safe }}</style>

		{%- js %}{% include "node_modules/@zachleat/heading-anchors/heading-anchors.js" %}{% endjs %}
	</head>
	<body class={% if page.url == '/' %}page-home{% else %}{% set slugParts = ['page', page.fileSlug] %}{{slugParts | join('-')}}{% endif %}>
		<a href="#main" class="u-visually-hidden">Skip to main content</a>

		{% if show_header != false %}
			{% include "components/site-header.njk" %}
		{% endif %}

		<main id="main" class="u-container">
			{{ content | typogrify | safe }}
		</main>

		{% if show_footer != false %}
			{% include "components/site-footer.njk" %}
		{% endif %}

		<!-- This page `{{ page.url }}` was built on {% currentBuildDate %} -->
		<script type="module" src="{% getBundleFileUrl "js" %}"></script>
	</body>
</html>
